# Copy to .env and fill in real values; docker-compose.yml reads these and passes them in as
# environment variables, which override the matching keys in appsettings.json.
# .env is gitignored — do not commit real credentials.

# --- Storage ---
# SQLite database file. Must stay under /var/srv, which docker-compose.yml mounts as a volume —
# anywhere else and the database is inside the container's writable layer and dies with it.
CONNECTION_STRING=Data Source=/var/srv/filehub.db
# Where the ASP.NET Data Protection key ring is written. Same volume, same reason: these keys
# encrypt the auth cookies and the stored SMTP password. Lose them and every session is signed
# out on the next redeploy and the saved SMTP password becomes undecryptable.
DATA_PROTECTION_KEY_PATH=/var/srv/keys

# --- Public origin ---
# The origin a browser actually uses to reach FileHub, no trailing slash. This is not cosmetic:
# share links and the links in invitation and password-reset mails are built from it, so if it is
# wrong every link you hand out points somewhere nobody can open.
APP_BASE_URL=https://file-hub.example.com

# --- Bootstrap admin ---
# Seeded ONLY when the database has no admin account, i.e. on a fresh install. On a fresh install
# this is also the ONLY account that exists — there is no self-registration; every other user is
# created by an admin and activated through an invitation mail.
# The password here is a bootstrap credential, nothing more: the seeded account is created with
# MustChangePassword, so the first thing that session is allowed to do is replace it. Change it
# at the first sign-in, then this value stops mattering — restarting the app never resets a
# password that has already been changed.
# Minimum length is 8 characters. Leave it EMPTY to have the app generate a random password and
# write it to the log once, on the run that creates the account (`docker compose logs file-hub`) —
# that is the safer default, since a password written in a file here is a credential that exists
# before anyone has signed in.
ADMIN_EMAIL=admin@filehub.example.com
ADMIN_PASSWORD=

# --- Logging ---
# Minimum log level for console output and the SQLite "Logs" table.
# One of: Trace, Debug, Information, Warning, Error, Critical. Defaults to Information.
LOG_LEVEL=Information

# --- Email / SMTP ---
# Seed values for the EmailSettings row. Once an admin edits the mail settings in the UI, that row
# is what gets used and these are ignored. Without a working SMTP host, invitations and password
# resets cannot be delivered — the bootstrap admin above is then your only way in.
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=apikey
EMAIL_PASSWORD=change-me
EMAIL_FROM_ADDRESS=no-reply@filehub.example.com
EMAIL_FROM_NAME=FileHub
# One of: None, Auto, SslOnConnect, StartTls, StartTlsWhenAvailable
EMAIL_SECURE_SOCKET_OPTIONS=StartTls
