<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>FileHub</RootNamespace>
    </PropertyGroup>

    <!-- The SPA build output lives in wwwroot; keep it out of the compile/publish item groups
         (the Dockerfile copies it in) but watched, so `npm run watch` triggers LiveReload. -->
    <PropertyGroup>
        <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\**</DefaultItemExcludes>
    </PropertyGroup>
    <ItemGroup>
        <Watch Include="wwwroot\**\*" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.SQLite" Version="7.0.0" />
        <!-- Serilog.Sinks.SQLite pulls its own (older) SQLitePCLRaw chain; pin the patched
             native bundle here too (GHSA-2m69-gcr7-jv3q). -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
        <PackageReference Include="Westwind.AspNetCore.LiveReload" Version="0.7.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FileHub.BusinessLogic\FileHub.BusinessLogic.csproj" />
        <ProjectReference Include="..\FileHub.Dal\FileHub.Dal.csproj" />
        <ProjectReference Include="..\FileHub.Dtos\FileHub.Dtos.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="EmailTemplates\**\*.html" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="wwwroot\" />
    </ItemGroup>

</Project>
